<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_cadier_card"
    android:elevation="2dp"
    android:padding="14dp">

    <TextView
        android:id="@+id/textViewPedidoAgendados"
        style="@style/Cadier.Text.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pedido"/>

    <TextView
        android:id="@+id/textViewDataAgendados"
        style="@style/Cadier.Text.Body.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Data do Pedido"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:background="@drawable/bg_cadier_stat_teal"
            android:padding="8dp">

            <TextView
                style="@style/Cadier.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valor"/>

            <TextView
                android:id="@+id/textViewValorAgendados"
                style="@style/Cadier.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cadier_teal_dark"
                android:textStyle="bold"
                android:text="R$ 00,00"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:background="@drawable/bg_cadier_stat_teal"
            android:padding="8dp">

            <TextView
                style="@style/Cadier.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pago"/>

            <TextView
                android:id="@+id/textViewPagoAgendados"
                style="@style/Cadier.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cadier_teal_dark"
                android:textStyle="bold"
                android:text="R$ 00,00"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_cadier_stat_warning"
            android:padding="8dp">

            <TextView
                style="@style/Cadier.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resta"/>

            <TextView
                android:id="@+id/textViewRestaAgendados"
                style="@style/Cadier.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/status_warning"
                android:textStyle="bold"
                android:text="R$ 00,00"/>
        </LinearLayout>

    </LinearLayout>

    <TextView
        style="@style/Cadier.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Serviço"/>

    <TextView
        android:id="@+id/textViewObsAgendados"
        style="@style/Cadier.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/cadier_teal_dark"
        android:textStyle="bold"
        android:text="Serviço"/>

</LinearLayout>
