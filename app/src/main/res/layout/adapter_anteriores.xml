<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_cadier_card"
    android:elevation="2dp"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textViewPedido"
            style="@style/Cadier.Text.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pedido"/>

        <TextView
            android:id="@+id/textViewStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cadier_text_on_dark"
            android:textStyle="bold"
            android:textSize="@dimen/cadier_text_caption"
            android:background="@color/status_success"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Finalizado!"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:background="@drawable/bg_cadier_stat_teal"
            android:padding="8dp">

            <TextView
                style="@style/Cadier.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data do Pedido"/>

            <TextView
                android:id="@+id/textViewDataPedido"
                style="@style/Cadier.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cadier_teal_dark"
                android:textStyle="bold"
                android:text="00/00/0000"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_cadier_stat_teal"
            android:padding="8dp">

            <TextView
                style="@style/Cadier.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data da Entrega"/>

            <TextView
                android:id="@+id/textViewDataEntrega"
                style="@style/Cadier.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cadier_teal_dark"
                android:textStyle="bold"
                android:text="00/00/0000"/>
        </LinearLayout>

    </LinearLayout>

    <TextView
        style="@style/Cadier.Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Serviço"/>

    <TextView
        android:id="@+id/textViewObservacoes"
        style="@style/Cadier.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/cadier_teal_dark"
        android:textStyle="bold"
        android:text="Serviço"/>

</LinearLayout>
