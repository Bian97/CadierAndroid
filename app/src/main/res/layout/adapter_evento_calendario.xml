<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#DDE3FD"
    android:padding="12dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginBottom="10dp"
        android:background="#000000"/>

    <TextView
        android:id="@+id/textViewTituloEvento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#012998"
        android:textStyle="bold"
        android:textSize="20sp"
        android:text="Título do evento"/>

    <TextView
        android:id="@+id/textViewCursoEvento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="15sp"
        android:background="#0247FE"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="Aula: Nome do Curso"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/textViewDataEvento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#0247FE"
        android:textStyle="bold"
        android:textSize="18sp"
        android:text="dd/MM/yyyy HH:mm"/>

    <TextView
        android:id="@+id/textViewLocalEvento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#012998"
        android:textSize="17sp"
        android:autoLink="none"
        android:text="Local"/>

    <TextView
        android:id="@+id/textViewDescricaoEvento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#333333"
        android:textSize="16sp"
        android:text="Descrição"/>

    <TextView
        android:id="@+id/textViewLinkEvento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="17sp"
        android:background="#1E8E3E"
        android:padding="10dp"
        android:gravity="center"
        android:text="Entrar na reunião"
        android:visibility="gone"/>

</LinearLayout>
