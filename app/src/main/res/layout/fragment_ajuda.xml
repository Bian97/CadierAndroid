<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cadier_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Cadier.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajuda"
            android:layout_marginBottom="16dp"
            android:textAlignment="center"
            android:layout_gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_cadier_card"
            android:elevation="3dp"
            android:padding="16dp">

            <TextView
                style="@style/Cadier.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Que a paz do Senhor Jesus esteja convosco! Este aplicativo foi feito com carinho para facilitar a sua vida como filiado da CADIER."/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_cadier_card"
            android:elevation="3dp"
            android:padding="8dp">

            <TextView
                style="@style/Cadier.Text.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="O que cada item do menu faz"/>

            <!-- Perfil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/inicioperfil"
                    android:tint="@color/cadier_teal"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Cadier.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cadier_teal_dark"
                        android:textStyle="bold"
                        android:text="Perfil"/>

                    <TextView
                        style="@style/Cadier.Text.Body.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seus dados principais e a data da sua última presença numa reunião."/>
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Cadier.Divider"/>

            <!-- Documentos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_documentos"
                    android:tint="@color/cadier_teal"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Cadier.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cadier_teal_dark"
                        android:textStyle="bold"
                        android:text="Documentos"/>

                    <TextView
                        style="@style/Cadier.Text.Body.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Envie os documentos exigidos na sua filiação (identidade, comprovante de residência, foto 3x4 e outros) e acompanhe o status de cada um: Pendente, Enviado, Aprovado ou Rejeitado. Sua filiação só é efetivada depois que um atendente aprova todos. A foto 3x4 pode ser trocada a qualquer momento e é usada na sua Credencial PVC - ao enviá-la, você pode recortar a imagem e usar o botão de melhorar a foto automaticamente."/>
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Cadier.Divider"/>

            <!-- Calendário -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/calendario"
                    android:tint="@color/cadier_teal"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Cadier.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cadier_teal_dark"
                        android:textStyle="bold"
                        android:text="Calendário"/>

                    <TextView
                        style="@style/Cadier.Text.Body.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Eventos e aulas cadastrados pela secretaria - dá pra ver sem entrar na conta, direto na tela de login."/>
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Cadier.Divider"/>

            <!-- Pedidos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/pedidos"
                    android:tint="@color/cadier_teal"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Cadier.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cadier_teal_dark"
                        android:textStyle="bold"
                        android:text="Pedidos"/>

                    <TextView
                        style="@style/Cadier.Text.Body.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seus pedidos de Pessoa Física - os pendentes numa aba, os já concluídos em outra."/>
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Cadier.Divider"/>

            <!-- Mensalidades -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/datapresente"
                    android:tint="@color/cadier_teal"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Cadier.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cadier_teal_dark"
                        android:textStyle="bold"
                        android:text="Mensalidades"/>

                    <TextView
                        style="@style/Cadier.Text.Body.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sua situação com a CADIER (só Pessoa Física) - e, se você for responsável por uma igreja, a mensalidade dela também aparece aqui."/>
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Cadier.Divider"/>

            <!-- Configurações -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/configuracoes"
                    android:tint="@color/cadier_teal"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Cadier.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cadier_teal_dark"
                        android:textStyle="bold"
                        android:text="Configurações"/>

                    <TextView
                        style="@style/Cadier.Text.Body.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Altere seus dados: telefone, e-mail, endereço, cônjuge, profissão e foto de perfil."/>
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Cadier.Divider"/>

            <!-- Contatos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/contatos1"
                    android:tint="@color/cadier_teal"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Cadier.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cadier_teal_dark"
                        android:textStyle="bold"
                        android:text="Contatos"/>

                    <TextView
                        style="@style/Cadier.Text.Body.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Os meios de comunicação com a CADIER - WhatsApp, e-mail, Facebook e site."/>
                </LinearLayout>
            </LinearLayout>

            <View style="@style/Cadier.Divider"/>

            <!-- Sair -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/deslogar"
                    android:tint="@color/cadier_teal"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Cadier.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cadier_teal_dark"
                        android:textStyle="bold"
                        android:text="Sair"/>

                    <TextView
                        style="@style/Cadier.Text.Body.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Desloga do aplicativo. Você pode entrar novamente a qualquer momento."/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_cadier_card"
            android:elevation="3dp"
            android:padding="16dp">

            <TextView
                style="@style/Cadier.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agradeço imensamente por fazer parte da nossa família! Que a paz do Senhor Jesus seja convosco. Amém!"/>
        </LinearLayout>

        <Button
            android:id="@+id/buttonPolitica"
            style="@style/Cadier.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Política de Privacidade" />
    </LinearLayout>
</ScrollView>