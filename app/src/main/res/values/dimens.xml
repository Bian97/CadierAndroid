<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>
    <dimen name="nav_header_vertical_spacing">8dp</dimen>
    <dimen name="nav_header_height">176dp</dimen>
    <dimen name="fab_margin">16dp</dimen>

    <!--
      Escala tipográfica CADIER - maior que o padrão Material (público majoritariamente idoso, ver
      memória "cadier-elderly-accessible-typography"). Body normal do Android é 14sp; aqui o piso é
      16sp e o texto "principal" de cada tela é 18sp+.
    -->
    <dimen name="cadier_text_title">22sp</dimen>
    <dimen name="cadier_text_subtitle">18sp</dimen>
    <dimen name="cadier_text_body">17sp</dimen>
    <dimen name="cadier_text_body_secondary">16sp</dimen>
    <dimen name="cadier_text_caption">15sp</dimen>
    <dimen name="cadier_text_button">17sp</dimen>

    <!-- Raios de borda - mesmos valores do site (theme.js: shape.borderRadius=10, MuiButton=14). -->
    <dimen name="cadier_radius_card">10dp</dimen>
    <dimen name="cadier_radius_button">14dp</dimen>
    <dimen name="cadier_radius_chip">20dp</dimen>
    <dimen name="cadier_radius_input">8dp</dimen>

    <!-- Altura mínima de toque confortável pra dedos menos precisos. -->
    <dimen name="cadier_touch_target_min">48dp</dimen>
</resources>
