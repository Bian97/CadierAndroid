<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Mesmo gradiente teal do menu lateral do site (Menu.css: linear-gradient(160deg, #128C86
         0%, #0C6C67 65%, #094e4a 100%)) - ângulo aproximado, XML shape só aceita múltiplos de 45. -->
