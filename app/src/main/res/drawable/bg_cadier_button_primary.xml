<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/cadier_text_secondary"/>
            <corners android:radius="@dimen/cadier_radius_button"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cadier_teal_dark"/>
            <corners android:radius="@dimen/cadier_radius_button"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cadier_teal"/>
            <corners android:radius="@dimen/cadier_radius_button"/>
        </shape>
    </item>
</selector>
